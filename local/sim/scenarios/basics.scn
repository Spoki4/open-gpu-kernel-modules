# What the policy does right today (it must keep doing it): a game in the
# foreground gets its memory from hidden apps, not from a visible one that
# draws; a hidden app comes back when focused; the compositor is never turned
# away; nothing moves while there is room.
cap 11000
proc 1614 kwin_wayland old
proc 1625 plasmashell old
proc 2589 chrome old chunk=16           # hidden behind the game, idle
proc 3877 spotify old chunk=16          # hidden, idle
proc 2094 ghostty old chunk=8           # visible on monitor 2, drawing
proc 5000 game chunk=64

hint 1625 v
hint 2589 h
hint 3877 h
hint 2094 v
act 1614 0 4
act 1625 0 4
act 2589 120 0
act 3877 300 0
act 2094 0 4
target 1614 280 0.75
target 1625 480 0.4
target 2589 1500 0.7
target 3877 300 0.8
target 2094 250 0.55
at 10
expect evicts 2589 == 0          # room for everyone: nothing moves
expect evicts 3877 == 0

mark the game starts in the foreground and fills vidmem
hint 5000 f
act 5000 0 30
target 5000 4000 0.75 spread=10
at 20
target 5000 8800 0.75 spread=20
at 60
expect denied 5000 == 0          # hidden apps made room for all of it
expect sys 5000 == 0
expect sys 2094 == 0             # the drawing visible terminal kept its memory
expect evicted 2589 > 0          # the hidden browser paid

mark kwin needs a new 32 MB buffer with vidmem full
target 1614 312 0.75
at 62
expect denied 1614 == 0

mark the user alt-tabs to the browser (the game goes hidden, the browser comes back)
hint 5000 h
hint 2589 f
act 2589 0 4
step
at 64
expect sys 2589 == 0
at 70
mark and back to the game
hint 2589 h
act 2589 30 0
hint 5000 f
step
at 72
expect sys 5000 == 0
at 120
expect sys 5000 == 0
expect denied 5000 == 0
