# A 6 GB card (RTX 2060 / 3050 class): the focused game's headroom is the
# same share of the card as on the 12 GB cards the defaults were tuned on,
# 1 GB instead of 2 (vepScaleToCard()). A game there is told a 6 GB budget
# and loads in steps to match; with 2 GB kept free every hidden app and then
# the visible chat on the other monitor went to sysmem for room the game
# never asked for.
set card_gb 6
cap 5600
set compact 0
proc 1614 kwin_wayland old
proc 3403 spotify old
proc 2837 chrome old
proc 4410 discord old
proc 11571 game.exe old

act 1614 0 4
alloc 1614 250 n=5 fixed
alloc 2837 600
alloc 3403 300
alloc 4410 300
hint 1614 v
hint 2837 h
hint 3403 h
hint 4410 v
act 2837 60 0
act 3403 60 0
act 4410 60 0
hint 11571 f full launched
act 11571 0 30
alloc 11571 3200 n=16
at 10
mark the game loads the next area
alloc 11571 300 n=2
at 14
expect sys 4410 == 0             # the visible chat keeps its memory
expect sys 3403 == 0             # one hidden app gave enough
expect sys 11571 == 0
expect free - >= 1024
